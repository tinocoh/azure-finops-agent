{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "openAiLocation": {
      "value": "${AZURE_OPENAI_LOCATION}"
    },
    "openAiDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o}"
    },
    "openAiModelName": {
      "value": "${AZURE_OPENAI_MODEL_NAME=gpt-4o}"
    },
    "openAiModelVersion": {
      "value": "${AZURE_OPENAI_MODEL_VERSION=2024-11-20}"
    },
    "openAiCapacity": {
      "value": "${AZURE_OPENAI_CAPACITY=50}"
    },
    "appServicePlanSku": {
      "value": "${AZURE_APP_SERVICE_SKU=P0v3}"
    },
    "enablePrivateNetworking": {
      "value": "${ENABLE_PRIVATE_NETWORKING=false}"
    },
    "deployAgentService": {
      "value": "${DEPLOY_AGENT_SERVICE=true}"
    },
    "finopsReadOnly": {
      "value": "${FINOPS_READONLY=true}"
    },
    "microsoftClientId": {
      "value": "${AZURE_CLIENT_APP_ID=}"
    }
  }
}

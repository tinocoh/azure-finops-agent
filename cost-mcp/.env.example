# Required for Cost Management tools (azure_query_costs, azure_query_costs_by_resource,
# azure_get_cost_forecast, azure_list_budgets). Without these, only retail price tools work.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Optional
AZURE_USE_MANAGED_IDENTITY=false
AZURE_RETAIL_DEFAULT_CURRENCY=USD

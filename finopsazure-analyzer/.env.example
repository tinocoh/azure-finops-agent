# Copia este archivo a .env y completa los valores. NO pongas secretos reales aquí.
APP_ENV=local
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Base de datos: SQLite en local. Para PostgreSQL usa:
# postgresql+psycopg2://user:pass@host:5432/finopsazure
DATABASE_URL=sqlite:///./data/finopsazure.db

# Clave Fernet para cifrar secretos en reposo. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINOPS_CONFIG_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Azure OpenAI / Foundry (opcional — sin esto se usa resumen basado en reglas)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Preferir Managed Identity en Azure. Solo usar API key en local si es necesario.
AZURE_OPENAI_API_KEY=

# Key Vault (Azure). En local se deja vacío.
KEY_VAULT_URI=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Copy this file to .env and complete the values. Do NOT put real secrets here.
APP_ENV=local
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database: SQLite locally. For PostgreSQL use:
# postgresql+psycopg2://user:pass@host:5432/finopsazure
DATABASE_URL=sqlite:///./data/finopsazure.db

# Fernet key for encrypting secrets at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINOPS_CONFIG_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Azure OpenAI / Foundry (optional; without this, rule-based summaries are used)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Prefer Managed Identity in Azure. Use an API key locally only if needed.
AZURE_OPENAI_API_KEY=

# Key Vault (Azure). Leave empty locally.
KEY_VAULT_URI=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
